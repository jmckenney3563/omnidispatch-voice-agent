# ==============================================================================
# OmniDispatch Voice Agent - Environment Configuration
# ==============================================================================

# AssemblyAI API Configuration
# Optional: If left empty, OmniDispatch runs in zero-config simulation mode
# with realistic 16kHz audio synthesis and full Universal-3 Pro STT streaming emulation.
# To connect to live AssemblyAI Realtime WebSocket API:
ASSEMBLYAI_API_KEY=

# AssemblyAI Realtime WebSocket Endpoint
ASSEMBLYAI_REALTIME_URL=wss://api.assemblyai.com/v2/realtime/ws

# Audio Telemetry
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_MS=100

# Turn-Taking & VAD
VAD_SILENCE_THRESHOLD_MS=750
VAD_ENERGY_THRESHOLD=0.015
AUTO_TOOL_EXECUTION=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
